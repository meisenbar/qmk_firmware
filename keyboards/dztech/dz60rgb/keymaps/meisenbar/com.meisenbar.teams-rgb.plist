<?xml version="1.0" encoding="UTF-8"?>
<!--
  Blinks the keyboard purple when the Teams Dock badge count rises (see teams-notify.ts).
  install:   cp com.meisenbar.teams-rgb.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.meisenbar.teams-rgb.plist
  uninstall: launchctl bootout gui/$(id -u)/com.meisenbar.teams-rgb && rm ~/Library/LaunchAgents/com.meisenbar.teams-rgb.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meisenbar.teams-rgb</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/qmk_firmware/keyboards/dztech/dz60rgb/keymaps/meisenbar/run-node.sh" "$HOME/qmk_firmware/keyboards/dztech/dz60rgb/keymaps/meisenbar/teams-notify.ts"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/teams-rgb.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/teams-rgb.log</string>
</dict>
</plist>
